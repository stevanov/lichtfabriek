# console configuration contract (SPEC §C, §I). Copy to .env and fill in.
# Never commit real values — this file holds placeholders only (V9, V20).

# ---- Flask ----
# Long random value; generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Bootstrap admin password; first login forces a change (V11)
ADMIN_PASSWORD=change-me-on-first-deploy

# ---- MQTT broker ----
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- shared payload crypto (V9) ----
# Must match kubusd's PAYLOAD_KEY.
PAYLOAD_KEY=
KEY_ID=k1

# ---- runtime ----
SQLITE_PATH=./data/console.db
TZ=Europe/Amsterdam
RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=0
