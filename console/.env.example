# console .env — copy next to console/app.py (dev) or inject via secrets (prod, V9)
# MQTT broker — must be reachable by kubusd too
MQTT_BROKER=localhost
MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=

# Payload crypto (V9) — MUST MATCH kubusd PAYLOAD_KEY. Never commit.
PAYLOAD_KEY=change-me-must-match-kubusd
KEY_ID=k1

# Flask sessions
SECRET_KEY=change-me
# First admin account (forced password change on first login, V11)
ADMIN_PASSWORD=admin
# Initial admin username is always 'admin'

# Console DB (V6, V19: IPs live here, never in MQTT)
SQLITE_PATH=./data/console.db

# Publishing
RATE_LIMIT_PER_MINUTE=10
TZ=Europe/Amsterdam

# Set TRUST_PROXY=1 only when running behind a reverse proxy that sets
# X-Forwarded-For correctly (V7). Otherwise keep 0.
TRUST_PROXY=0
