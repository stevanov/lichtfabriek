# kubusd configuration contract (SPEC §C, §I). Copy to .env and fill in.
# Never commit real values — this file holds placeholders only (V9, V20).
# No absolute/host paths: defaults are relative (./data/...) (V20).

# ---- MQTT broker ----
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- shared payload crypto (V9) ----
# Must match the console's PAYLOAD_KEY. Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PAYLOAD_KEY=
KEY_ID=k1

# ---- pigpio daemon ----
PIGPIOD_HOST=localhost
PIGPIOD_PORT=8888

# ---- GPIO pin map (V24: cube 0 = TOPMOST tank, 1 = middle, 2 = bottom) ----
# 9 PWM pins, one per strip channel, ordered cube0 R,G,B / cube1 R,G,B / cube2 R,G,B
PWM_PINS=0,1,2,3,4,5,6,7,8
# 5 sign outputs: anvil, raised, swing, impact, sparks
SIGN_PINS=10,11,12,13,14

# ---- runtime (relative paths, no host paths in repo) ----
SQLITE_PATH=./data/kubusd.db
SIGN_SCHEDULE={"enabled": true, "start": "18:00", "stop": "23:00"}
TZ=Europe/Amsterdam
FRAME_RATE=30
LOG_LEVEL=INFO

# ---- simulator (dev only) ----
SIM_COLS=60
