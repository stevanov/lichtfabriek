# kubusd .env — copy to the directory kubusd runs from (dev: repo root, Pi: set by install.sh)
# MQTT broker (SPEC §I)
MQTT_BROKER=localhost
MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=

# Payload crypto (V9) — SHARED with console, keep secret, never commit
PAYLOAD_KEY=change-me-generate-with: python3 -c "from shared.crypto import new_key; print(new_key())"
KEY_ID=k1

# pigpio daemon (V1)
PIGPIOD_HOST=localhost
PIGPIOD_PORT=8888

# GPIO pin map: 9 PWM (strip1 R,G,B strip2 R,G,B strip3 R,G,B) + 5 sign outputs
PWM_PINS=4,17,27,22,23,24,25,5,6
SIGN_PINS=12,13,19,26,20

# SQLite state (V3, V16) — relative path, resolved against the working dir
SQLITE_PATH=./data/kubusd.db

# Sign schedule (V5, V18): JSON, runtime MQTT overrides this
#SIGN_SCHEDULE={"enabled": true, "start": "18:00", "stop": "23:00"}
TZ=Europe/Amsterdam

# Engine
FRAME_RATE=30
LOG_LEVEL=INFO
